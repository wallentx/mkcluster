# CPU development cluster. Values are literal, without shell quoting or expansion.
MKCLUSTER_NAME=local
MKCLUSTER_PROVIDER=docker
MKCLUSTER_WORKER_COUNT=1
MKCLUSTER_IP_FAMILY=ipv4
MKCLUSTER_K8S_VERSION=latest
MKCLUSTER_API_SERVER_ADDRESS=127.0.0.1
MKCLUSTER_API_SERVER_PORT=6443
MKCLUSTER_HTTP_PORT=8080
MKCLUSTER_HTTPS_PORT=8443
MKCLUSTER_REGISTRY_NAME=kind-local-registry
MKCLUSTER_REGISTRY_PORT=5001
MKCLUSTER_KUBECONFIG=./local.kubeconfig
MKCLUSTER_GPU=false
MKCLUSTER_GPU_DRA=false
MKCLUSTER_WAIT=5m
