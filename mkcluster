NVIDIA_DRA_DRIVER_NAMESPACE='nvidia-dra-driver-gpu'
NVIDIA_HELM_INDEX_URL='https://helm.ngc.nvidia.com/nvidia/index.yaml'
REMOTE_LOOKUP_TIMEOUT="${MKCLUSTER_REMOTE_LOOKUP_TIMEOUT:-5}"
KIND_VERSION=''
KIND_LATEST_RELEASE_JSON=''
NVIDIA_DRA_DRIVER_CHART_VERSION=''
NVIDIA_DRA_DRIVER_ROOT="${MKCLUSTER_NVIDIA_DRA_DRIVER_ROOT:-/}"
OPTION_LABEL_WIDTH=31
OPTION_DESC_WIDTH=54

DEFAULT_CLUSTER_NAME=''
DEFAULT_REGISTRY_NAME=''
DEFAULT_REGISTRY_PORT=''
DEFAULT_WORKER_COUNT=''
DEFAULT_IP_FAMILY=''
DEFAULT_KUBERNETES_VERSION=''
DEFAULT_KIND_NODE_IMAGE=''
DEFAULT_PROVIDER=''
DEFAULT_API_SERVER_ADDRESS=''
DEFAULT_API_SERVER_PORT=''

cluster_name=''
registry_name=''
registry_port=''
worker_count=''
gpu_enabled=false
gpu_dra_enabled=false
ip_family=''
kubernetes_version=''
provider=''
kind_node_image=''
node_image_explicit=false
kubernetes_version_explicit=false
api_server_address=''
api_server_port=''
container_cli=''
gpu_mounts=()

kind_extra_args=()
kind_nodes=()
feature_gates=()
cli_feature_gates=()
cluster_network_name=''
action='create'
profile_path=''
lock_path=''
kubeconfig_path=''
kubeconfig_explicit=false
http_port=80
https_port=443
readiness_timeout=5m
resume_enabled=false
gpu_detected=false
